# WeChatRSS Environment Configuration

# --- Translation Service Configuration ---
# Target language to translate articles into (e.g., en, de, fr, es, etc.)
TRANSLATION_TARGET_LANG=en

# 1. DeepL API (Primary Translator)
# Free keys usually end with :fx
DEEPL_API_KEY=

# 2. Google Translate API v2 (First Fallback)
# Create a standard API Key in GCP Console with Cloud Translation API enabled
GOOGLE_TRANSLATE_API_KEY=

# 3. LibreTranslate API (Last Resort Fallback)
# URL of the LibreTranslate instance (self-hosted or public)
LIBRETRANSLATE_API_URL=http://localhost:5000
# Optional API key if your LibreTranslate instance requires authentication
LIBRETRANSLATE_API_KEY=
